import consts
import random
import screen
import soldier

field_grid = []
mines_positions = []

#פונקציה ליצירת גריד
def create():
    global field_grid
    field_grid = []

    for row in range(consts.BOARD_ROWS):
        current_row = []
        for col in range(consts.BOARD_COLS):
            current_row.append(consts.EMPTY_CELL)
        field_grid.append(current_row)

    place_flag(field_grid)
    global mines_positions
    mines_positions = place_mines(field_grid)
    place_soldier(field_grid)

#מיקום הדגל יקבע לפי הקבועים הנתונים לנו
def get_flag_position():
    flag_row = consts.BOARD_ROWS - consts.FLAG_ROWS
    flag_col = consts.BOARD_COLS - consts.FLAG_COLS
    return flag_row, flag_col

#ניצור רשימה של קורדינטות שבהן צריך להיות דגל
def get_flag_cells():
    flag_row, flag_col = get_flag_position()
    flag_cells = []
    for row in range(flag_row, flag_row + consts.FLAG_ROWS):
        for col in range(flag_col, flag_col + consts.FLAG_COLS):
            flag_cells.append((row, col))

    return flag_cells

#נמקם בגריד את תאי הדגל (במקרה שלנו- F)
def place_flag(board):
    flag_cells = get_flag_cells()
    for row , col in flag_cells:
        board[row][col] = consts.FLAG_CELL

#פונקציה להקמת מוקשים ראנדומלים על הגריד
def place_mines(board):
    mines_positions = []
    #לא נסיים את הקמת המוקשים עד שלא נוודא שכל מיקומם תקינים (מקום תקין = הסבר בפונקציה)
    while len(mines_positions) < consts.MINES_COUNT:
        mine_row = random.randint(0 , consts.BOARD_ROWS - consts.MINE_ROWS)
        mine_col = random.randint(0 , consts.BOARD_COLS - consts.MINE_COLS)
        mine_cells = [] #עם הקורדינטות שיכנסו לכאן (באופן ראנדומלי) על ידי הלולאה הבאה, נוכל לבדוק את תקינותם על הגריד

        for row in range(mine_row, mine_row + consts.MINE_ROWS):
            for col in range(mine_col, mine_col + consts.MINE_COLS):
                mine_cells.append((row, col))

        is_valid = True
        for row , col in mine_cells:
            #בדיקה ראשונה- האם יש דגל במיקום הראנדומלי של המוקש
            if board[row][col] != consts.EMPTY_CELL:
                is_valid = False
                break
            #בדיקה שניה- המוקש לא ימוקם במיקום ההתחלתי של החייל
            if row < consts.SOLDIER_ROWS and col < consts.SOLDIER_COLS:
                is_valid = False
                break
        #אם המוקש עבר את כל הבדיקות נוסיף את הנקודה השמאלית שלו לרשימת הקורדינטות מוקשים שלנו
        if is_valid:
            for row , col in mine_cells:
                #וגם כבר נמקם אותו על הלוח
                board[row][col] = consts.MINE_CELL
            mines_positions.append((mine_row, mine_col))
    return mines_positions

#פונקציה למציאת המיקום הנוכחי של החייל
def get_soldier_position():

    for row in range(consts.BOARD_ROWS):
        for col in range(consts.BOARD_COLS):
            if field_grid[row][col] == consts.SOLDIER_UPPER:
                return row, col

    return 0, 0

#פונקציה שתחזיר את הקורדינטות בהם פלג גוף העליון והתחתון של החייל צריכות להיות
def get_soldier_cells():
    upper_cells = []
    lower_cells = []
    soldier_row, soldier_col = get_soldier_position()
    # משבצות הגוף
    for row in range(soldier_row , soldier_row + consts.SOLDIER_BODY_ROWS):
        for col in range(soldier_col , soldier_col + consts.SOLDIER_COLS):
            upper_cells.append((row, col))
    # משבצות הרגליים
    feet_row = soldier_row + consts.SOLDIER_BODY_ROWS
    for col in range(soldier_col , soldier_col + consts.SOLDIER_COLS):
        lower_cells.append((feet_row, col))

    return upper_cells, lower_cells

#פונקציה שתמקם את החייל בקורדינטות המתאימות
def place_soldier(grid):
    for row in range(consts.SOLDIER_BODY_ROWS):
        for col in range(consts.SOLDIER_COLS):
            grid[row][col] = consts.SOLDIER_UPPER

    feet_row = consts.SOLDIER_BODY_ROWS
    for col in range(consts.SOLDIER_COLS):
        grid[feet_row][col] = consts.SOLDIER_LOWER

#הפונקציה המרכזית להזזת החייל
def move_soldier(row_change, col_change):
    soldier_row, soldier_col = get_soldier_position()
    new_row = soldier_row + row_change
    new_col = soldier_col + col_change

    # בדיקת גבולות הלוח
    if new_row < 0:
        return False
    if new_col < 0:
        return False
    if new_row + consts.SOLDIER_ROWS > consts.BOARD_ROWS:
        return False
    if new_col + consts.SOLDIER_COLS > consts.BOARD_COLS:
        return False

    # ניקוי המיקום הישן של החייל
    upper_cells, lower_cells = get_soldier_cells()
    for row, col in upper_cells + lower_cells:
        field_grid[row][col] = get_original_cell(row, col)

    # הצבת החייל במיקום החדש
    for row in range(new_row , new_row + consts.SOLDIER_BODY_ROWS):
        for col in range(new_col , new_col + consts.SOLDIER_COLS):
            field_grid[row][col] = consts.SOLDIER_UPPER

    feet_row = new_row + consts.SOLDIER_BODY_ROWS
    for col in range(new_col , new_col + consts.SOLDIER_COLS):
        field_grid[feet_row][col] = consts.SOLDIER_LOWER

    return True

#פונקציה שתזכור מה היה בתא לפני שחייל הגיע אליו
def get_original_cell(row, col):
    if (row, col) in get_flag_cells():
        return consts.FLAG_CELL

    for mine_row, mine_col in mines_positions:
        if (mine_row <= row < mine_row + consts.MINE_ROWS and
                mine_col <= col < mine_col + consts.MINE_COLS):
            return consts.MINE_CELL

    return consts.EMPTY_CELL

