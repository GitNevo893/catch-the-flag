# פונקציה ליצירת גריד ריק
def create_empty_grd():
    grd = []
    for row in range(consts.BOARD_ROWS):
        current_row = []
        for col in range(consts.BOARD_COLS):
            current_row.append(consts.EMPTY_CELL)

        grd.append(current_row)
    return grd


# מיקום הדגל יקבע לפי הקבועים הנתונים לנו
def get_flag_position():
    flag_row = consts.BOARD_ROWS - consts.FLAG_ROWS
    flag_col = consts.BOARD_COLS - consts.FLAG_COLS
    return flag_row, flag_col


# ניצור רשימה של קורדינטות שבהן צריך להיות דגל
def get_flag_cells():
    flag_row, flag_col = get_flag_position()
    flag_cells = []
    for row in range(flag_row, flag_row + consts.FLAG_ROWS):
        for col in range(flag_col, flag_col + consts.FLAG_COLS):
            flag_cells.append((row, col))

    return flag_cells


# נמקם בגריד את תאי הדגל (במקרה שלנו- 2)
def place_flag(board):
    flag_cells = get_flag_cells()
    for row, col in flag_cells:
        board[row][col] = consts.FLAG_CELL


# פונקציה להקמת מוקשים ראנדומלים על הגריד
def place_mines(board):
    mines_positions = []
    # לא נסיים את הקמת המוקשים עד שלא נוודא שכל מיקומם תקינים (מקום תקין = הסבר בפונקציה)
    while len(mines_positions) < consts.MINES_COUNT:
        mine_row = random.randint(0, consts.BOARD_ROWS - consts.MINE_ROWS)
        mine_col = random.randint(0, consts.BOARD_COLS - consts.MINE_COLS)
        mine_cells = []  # עם הקורדינטות שיכנסו לכאן (באופן ראנדומלי) על ידי הלולאה הבאה, נוכל לבדוק את תקינותם על הגריד

        for row in range(mine_row, mine_row + consts.MINE_ROWS):
            for col in range(mine_col, mine_col + consts.MINE_COLS):
                mine_cells.append((row, col))

        is_valid = True
        for row, col in mine_cells:
            # בדיקה ראשונה- האם יש דגל במיקום הראנדומלי של המוקש
            if board[row][col] != consts.EMPTY_CELL:
                is_valid = False
                break
            # בדיקה שניה- המוקש לא ימוקם במיקום ההתחלתי של החייל
            if row < consts.SOLDIER_ROWS and col < consts.SOLDIER_COLS:
                is_valid = False
                break
        # אם המוקש עבר את כל הבדיקות נוסיף את הנקודה השמאלית שלו לרשימת הקורדינטות מוקשים שלנו
        if is_valid:
            for row, col in mine_cells:
                # וגם כבר נמקם אותו על הלוח
                board[row][col] = consts.MINE_CELL
            mines_positions.append((mine_row, mine_col))
    return mines_positions

#יצירת הגריד המרכזי שלנו
