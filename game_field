import consts
import random
import screen
import soldier

field_grid = []

#פונקציה ליצירת גריד ריק
def create_empty_grd():
    grd = []
    for row in range(consts.BOARD_ROWS):
        current_row = []
        for col in range(consts.BOARD_COLS):
            current_row.append(consts.EMPTY_CELL)

        grd.append(current_row)
    return grd

#מיקום הדגל יקבע לפי הקבועים הנתונים לנו
def get_flag_position():
    flag_row = consts.BOARD_ROWS - consts.FLAG_ROWS
    flag_col = consts.BOARD_COLS - consts.FLAG_COLS
    return flag_row, flag_col

#ניצור רשימה של קורדינטות שבהן צריך להיות דגל
def get_flag_cells():
    flag_row, flag_col = get_flag_position()
    flag_cells = []
    for row in range(flag_row, flag_row + consts.FLAG_ROWS):
        for col in range(flag_col, flag_col + consts.FLAG_COLS):
            flag_cells.append((row, col))

    return flag_cells

#נמקם בגריד את תאי הדגל (במקרה שלנו- 2)
def place_flag(board):
    flag_cells = get_flag_cells()
    for row , col in flag_cells:
        board[row][col] = consts.FLAG_CELL

#פונקציה להקמת מוקשים רנדומלים על הגריד
def place_mines(board):
    mines_positions = []
    #לא נסיים את הקמת המוקשים עד שלא נוודא שכל מיקומם תקינים (מקום תקין = הסבר בפונקציה)
    while len(mines_positions) < consts.MINES_COUNT:
        mine_row = random.randint(0 , consts.BOARD_ROWS - consts.MINE_ROWS)
        mine_col = random.randint(0 , consts.BOARD_COLS - consts.MINE_COLS)
        mine_cells = [] #עם הקורדינטות שיכנסו לכאן (באופן ראנדומלי) על ידי הלולאה הבאה, נוכל לבדוק את תקינותם על הגריד

        for row in range(mine_row, mine_row + consts.MINE_ROWS):
            for col in range(mine_col, mine_col + consts.MINE_COLS):
                mine_cells.append((row, col))

        is_valid = True
        for row , col in mine_cells:
            #בדיקה ראשונה- האם יש דגל במיקום הראנדומלי של המוקש
            if board[row][col] != consts.EMPTY_CELL:
                is_valid = False
                break
            #בדיקה שניה- המוקש לא ימוקם במיקום ההתחלתי של החייל
            if row < consts.SOLDIER_ROWS and col < consts.SOLDIER_COLS:
                is_valid = False
                break
        #אם המוקש עבר את כל הבדיקות נוסיף את הנקודה השמאלית שלו לרשימת הקורדינטות מוקשים שלנו
        if is_valid:
            for row , col in mine_cells:
                #וגם כבר נמקם אותו על הלוח
                board[row][col] = consts.MINE_CELL
            mines_positions.append((mine_row, mine_col))
    return mines_positions

#פונקציה למציאת המיקום הנוכחי של החייל
def get_soldier_position():
    soldier_row = None
    soldier_col = None
    #נעבור על הגריד למציאת הU הראשון
    for r  , row in enumerate(field_grid):
        for c in range(len(row)):
            if field_grid[r][c] == consts.SOLDIER_UPPER:
                soldier_row = r
                soldier_col = c
            break
    #במידה והחייל עוד לא מופיע על המסך
    if soldier_row == None:
        soldier_row = 0
        soldier_col = 0

    return soldier_row , soldier_col

#פונקציה שתחזיר את הקורדינטות בהם פלג גוף העליון והתחתון של החייל צריכות להיות
def get_soldier_cells():
    soldier_upper_cells_crdts = []
    soldier_lower_cells_crdts = []
    starter_row , starter_col = get_soldier_position()

    for r in range(0 , consts.BOARD_ROWS - 1):
        for c in range(0 , consts.BOARD_COLS - 1):
            #פלג גוף עליון
            if r == starter_row and c == starter_col:
                go_down = 0
                for i in range(consts.SOLDIER_BODY_ROWS):
                    go_right = 0
                    for j in range(consts.SOLDIER_COLS):
                        soldier_upper_cells_crdts.append((r + go_down , c + go_right))
                        go_right += 1
                    go_down += 1
            #פלג גוף תחתון
            if r == starter_row - 1 + consts.SOLDIER_ROWS and c == starter_col:
                go_right = 0
                for p in range(consts.SOLDIER_COLS):
                    soldier_lower_cells_crdts.append((r , c + go_right))
                    go_right += 1

    return soldier_upper_cells_crdts , soldier_lower_cells_crdts

#פונקציה שתמקם את החייל בקורדינטות המתאימות
def place_soldier(grid):
    upper_cells , lower_cells = get_soldier_cells()

    for row , col in upper_cells:
        grid[row][col] = consts.SOLDIER_UPPER
    for row , col in lower_cells:
        grid[row][col] = consts.SOLDIER_LOWER

#יצירת הגריד המרכזי שלנו
def apply_to_field_grid(mtrx):
    mtrx = create_empty_grd()
    place_flag(mtrx)
    place_mines(mtrx)
    place_soldier(mtrx)
    return mtrx

field_grid = apply_to_field_grid(field_grid)

def draw(): # מעבר על המטריצה כדי לקבוע איזו תמונה צריך לצייר ואיפה, עם התנאים המתאימים.
    flag_y = 0
    flag_x = 0
    soldier_x = 0
    soldier_y = 0
    flag_objects = get_flag_cells()

    for row in range(0, len(field_grid) - 1):
        for object in range(0, len(field_grid[row]) - 1):
            if field_grid[row][object] == consts.EMPTY_CELL:
                continue
            # elif field_grid[row][object] == MINE_CELL and field_grid[row][object + 2] == MINE_CELL:
            #    image = pygame.image.load(mine_img, object, row)
            #    screen.visual_object_implementation(image)
            elif (row, object) == flag_objects[0]:
                flag_x = object * consts.CELL_SIZE
                flag_y = row * consts.CELL_SIZE
                screen.screen_display.blit(screen.create_flag(consts.FLAG_IMG), (flag_x, flag_y))
            elif field_grid[row][object] == consts.SOLDIER_UPPER and field_grid[row][object + 1] == consts.SOLDIER_UPPER and field_grid[row + 3][object] == consts.SOLDIER_LOWER:
                soldier_x = object * consts.CELL_SIZE
                soldier_y = row * consts.CELL_SIZE
                screen.screen_display.blit(screen.create_soldier(consts.SOLDIER_IMG), (soldier_x, soldier_y))
            else:
                continue
