import pygame
import consts
import game_field
import grass_field

screen_display = pygame.display.set_mode((consts.WINDOW_WIDTH, consts.WINDOW_HEIGHT))
pygame.display.set_caption('Catch the flag! - pygame')

def draw_game(): #game_state
    screen_display.fill(consts.BACKGROUND_COLOR)
    grass_field.draw_grass_field()
    game_field.draw()
    pygame.display.update()

def draw_game_lose(): #game_state
    screen_display.fill(consts.BACKGROUND_COLOR)
    grass_field.draw_grass_field()
    game_field.draw()
    screen_display.blit(create_lose(consts.YOU_LOSE_IMG), consts.LOSE_POSITION)
    pygame.display.update()

def draw_game_win(): #game_state
    screen_display.fill(consts.BACKGROUND_COLOR)
    grass_field.draw_grass_field()
    game_field.draw()
    screen_display.blit(create_win(consts.YOU_WIN_IMG), consts.LOSE_POSITION)
    pygame.display.update()

def create_flag(flag_img):
    flag = pygame.image.load(flag_img)
    sized_flag = pygame.transform.scale(
        flag, (consts.FLAG_WIDTH, consts.FLAG_HEIGHT)
    )
    return sized_flag

