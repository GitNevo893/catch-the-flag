import pygame
import consts
import game_field

screen_display = pygame.display.set_mode((consts.WINDOW_WIDTH, consts.WINDOW_HEIGHT))
pygame.display.set_caption('Catch the flag! - pygame')

def draw_game(): #game_state
    screen_display.fill(consts.BACKGROUND_COLOR)

    game_field.draw()

    pygame.display.update()

def create_flag(flag_img, X, Y):

    sized_flag = pygame.transform.scale(
        flag_img, (consts.FLAG_WIDTH, consts.FLAG_HEIGHT)
    )
    screen_display.blit(sized_flag, (X, Y))

def create_soldier(soldier_img, X, Y):

    sized_soldier = pygame.transform.scale(
        soldier_img, (consts.SOLDIER_WIDTH, consts.SOLDIER_HEIGHT)
    )
    screen_display.blit(sized_soldier, (X, Y))

def create_grass(grass_img, X, Y):              #צריך להיווצר רנדומלי *
    image = pygame.image.load(grass_img)
    sized_grass = pygame.transform.scale(
        grass_img, (consts.GRASS_WIDTH, consts.GRASS_HEIGHT)
    )
    screen_display.blit(sized_grass, (X, Y))

def create_mine(mine_img, X, Y):

    sized_mine = pygame.transform.scale(
        mine_img, (consts.MINE_WIDTH, consts.MINE_HEIGHT)
    )
    screen_display.blit(sized_mine, (X, Y))
